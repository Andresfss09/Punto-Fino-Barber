PORT=5000
NODE_ENV=development

# Base de Datos PostgreSQL (Neon Serverless)
DATABASE_URL="postgresql://neondb_owner:npg_dummy@ep-square-dummy.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:npg_dummy@ep-square-dummy.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Seguridad y Autenticación JWT
JWT_SECRET=tu_clave_secreta_jwt_de_alta_entropia_punto_fino_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=tu_clave_refresh_token_punto_fino_2026

# URLs de Origen Permitidas (CORS)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Proveedor Transaccional de Correos (Resend / SMTP)
RESEND_API_KEY=re_dummy_resend_api_key_punto_fino
EMAIL_FROM=Punto Fino <reservas@puntofino.co>
ADMIN_EMAIL=admin@puntofino.co

# Webhook de Resend
RESEND_WEBHOOK_SECRET=whsec_dummy_webhook_secret_punto_fino

# Google Maps API Key (Server/Geocoding)
GOOGLE_MAPS_API_KEY=AIzaSyDummyKey_ReplaceWithYourGoogleMapsServerKey