// Prisma Schema para Punto Fino - Barbería de Barrio (Santiago de Cali, Colombia)
// Base de Datos: Neon Serverless PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  BARBER
  CLIENT
}

enum AppointmentStatus {
  HOLD          // Bloqueo temporal atómico de 8 min mientras completa el checkout
  CONFIRMED     // Cita confirmada
  IN_PROGRESS   // Cliente en la silla
  COMPLETED     // Servicio finalizado y liquidado
  CANCELLED     // Cancelada por cliente o barbería
  NO_SHOW       // Inasistencia marcada por el barbero
}

enum PaymentMethod {
  EFECTIVO
  NEQUI
  DAVIPLATA
  DATAFONO
  TRANSFERENCIA_BANCARIA
  WOMPI_ONLINE
}

enum InventoryMovementType {
  ENTRADA_COMPRA
  SALIDA_VENTA
  MERMA_USO_INTERNO
  AJUSTE_ARQUEO
}

// -------------------------------------------------------------
// USUARIOS Y PERFILES
// -------------------------------------------------------------

model User {
  id              String            @id @default(uuid())
  email           String?           @unique
  phone           String            @unique // Formato E.164: +573158294012
  name            String
  passwordHash    String?           // Nullable para clientes sin cuenta obligatoria
  role            Role              @default(CLIENT)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  barberProfile   BarberProfile?
  clientProfile   ClientProfile?
  appointments    Appointment[]     @relation("ClientAppointments")
  consents        HabeasDataConsent[]
  cashSessions    CashSession[]
  deviceSessions  StaffDeviceSession[]
  auditLogs       AuditLog[]

  @@index([role, isActive])
}

model BarberProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname        String          // Ej: "El Fino", "El Primo", "Junior"
  bio             String?
  avatarUrl       String?
  // NOTA LEGAL: REVISAR CON CONTADOR / ABOGADO LABORAL (honorarios vs. salario)
  commissionRate  Decimal         @default(0.50) @db.Decimal(5, 2)
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)

  services        BarberService[]
  schedules       BarberSchedule[]
  absences        BarberAbsence[]
  appointments    Appointment[]   @relation("BarberAppointments")
  slotHolds       SlotHold[]
  settlements     CommissionSettlement[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive, sortOrder])
}

model ClientProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredBarberId String?
  loyaltyStamps   Int             @default(0) // Tarjeta de sellos digital (6to corte con descuento)
  totalVisits     Int             @default(0)
  totalSpentCOP   Int             @default(0)
  // Notas privadas del barbero para cortes futuros
  technicalNotes  String?         // Ej: "Fade #0.5 en sienes, cerquillo recto, piel sensible"

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// -------------------------------------------------------------
// HORARIOS Y DISPONIBILIDAD
// -------------------------------------------------------------

model BarberSchedule {
  id              String        @id @default(uuid())
  barberId        String
  barber          BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek       Int           // 0: Domingo, 1: Lunes, ..., 6: Sábado
  startTime       String        // "09:00"
  endTime         String        // "20:00"
  isWorking       Boolean       @default(true)

  @@unique([barberId, dayOfWeek])
}

model BarberAbsence {
  id              String        @id @default(uuid())
  barberId        String
  barber          BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  reason          String?       // "Descanso", "Cita médica", "Vacaciones"

  @@index([barberId, startDate, endDate])
}

// -------------------------------------------------------------
// SERVICIOS
// -------------------------------------------------------------

model Service {
  id              String          @id @default(uuid())
  name            String          // Ej: "Corte Clásico Punto Fino"
  slug            String          @unique
  description     String
  durationMinutes Int             @default(40)
  priceCOP        Int             // Almacenado como entero en COP
  requiresDeposit Boolean         @default(false)
  depositAmountCOP Int            @default(0)
  category        String          @default("Cortes") // Cortes, Barba, Faciales, Combos
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)

  barbers         BarberService[]
  appointmentItems AppointmentItem[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive, category])
}

model BarberService {
  barberId        String
  serviceId       String
  customPriceCOP  Int?
  customDuration  Int?

  barber          BarberProfile   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
}

// -------------------------------------------------------------
// CITAS Y CONCURRENCIA (SLOTHOLD)
// -------------------------------------------------------------

model Appointment {
  id              String            @id @default(uuid())
  bookingCode     String            @unique // Ej: "PF-8492"
  clientId        String
  client          User              @relation("ClientAppointments", fields: [clientId], references: [id])
  barberId        String
  barber          BarberProfile     @relation("BarberAppointments", fields: [barberId], references: [id])
  
  startTime       DateTime          // Con zona horaria America/Bogota
  endTime         DateTime
  totalDurationMin Int
  totalPriceCOP   Int
  status          AppointmentStatus @default(CONFIRMED)
  
  clientNotes     String?           // Notas del cliente al agendar
  barberNotes     String?           // Notas técnicas registradas en la silla
  isWalkIn        Boolean           @default(false)

  // Tokens criptográficos firmados de un solo uso para autogestión sin login
  actionToken     String?           @unique
  actionTokenExpiry DateTime?

  items           AppointmentItem[]
  transactions    CashTransaction[]
  emailLogs       EmailAuditLog[]
  slotHold        SlotHold?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([barberId, startTime])
  @@index([startTime, status])
}

model AppointmentItem {
  id              String        @id @default(uuid())
  appointmentId   String
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  priceCOP        Int
  durationMinutes Int
}

// Bloqueo atómico temporal de cupo para evitar doble reserva (Anti-Doble Reserva)
model SlotHold {
  id              String        @id @default(uuid())
  barberId        String
  barber          BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime
  sessionId       String        // Cookie/Fingerprint de sesión del navegador
  expiresAt       DateTime      // TTL de 8 minutos
  appointmentId   String?       @unique
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])

  createdAt       DateTime      @default(now())

  @@index([barberId, startTime, expiresAt])
}

// -------------------------------------------------------------
// CAJA, ARQUEO Y MÉTODOS DE PAGO DE BARRIO
// -------------------------------------------------------------

model CashSession {
  id              String            @id @default(uuid())
  openedByUserId  String
  openedBy        User              @relation(fields: [openedByUserId], references: [id])
  openingBalance  Int               // Base de caja inicial en efectivo
  closingBalance  Int?              // Arqueo físico al cierre
  expectedBalance Int?
  difference      Int?
  notes           String?
  openedAt        DateTime          @default(now())
  closedAt        DateTime?

  transactions    CashTransaction[]

  @@index([openedAt, closedAt])
}

model CashTransaction {
  id              String        @id @default(uuid())
  cashSessionId   String
  cashSession     CashSession   @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  appointmentId   String?
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  type            String        // INGRESO_SERVICIO, VENTA_PRODUCTO, RETIRO_GASTO
  paymentMethod   PaymentMethod
  amountCOP       Int
  description     String
  createdAt       DateTime      @default(now())

  @@index([cashSessionId, paymentMethod])
}

// -------------------------------------------------------------
// PRODUCTOS E INVENTARIO
// -------------------------------------------------------------

model Product {
  id              String              @id @default(uuid())
  name            String              // Ej: "Cera Pomada Fijación Fuerte Mate"
  brand           String              // Ej: "Bandido / Suavecito"
  description     String?
  priceCOP        Int
  costCOP         Int                 @default(0)
  stock           Int                 @default(0)
  minStock        Int                 @default(5)
  isActive        Boolean             @default(true)

  movements       InventoryMovement[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model InventoryMovement {
  id              String                @id @default(uuid())
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            InventoryMovementType
  quantity        Int
  notes           String?
  createdAt       DateTime              @default(now())
}

// -------------------------------------------------------------
// LIQUIDACIÓN DE COMISIONES (HONORARIOS)
// -------------------------------------------------------------

model CommissionSettlement {
  id                  String        @id @default(uuid())
  barberId            String
  barber              BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  periodStart         DateTime
  periodEnd           DateTime
  totalServicesCOP    Int
  commissionAmountCOP Int           // Por defecto el 50%
  tipsCOP             Int           @default(0)
  status              String        @default("PENDIENTE") // PENDIENTE, LIQUIDADO, PAGADO
  paidAt              DateTime?
  // NOTA: REVISAR CON CONTADOR / ABOGADO LABORAL
  legalDisclaimer     String        @default("Liquidación de honorarios independientes por servicios de barbería.")

  createdAt           DateTime      @default(now())

  @@index([barberId, periodStart, periodEnd])
}

// -------------------------------------------------------------
// HABEAS DATA (LEY 1581 DE 2012 / DECRETO 1377 DE 2013)
// -------------------------------------------------------------

model HabeasDataConsent {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyVersion     String        // Ej: "v1.0-2026-10"
  acceptedTerms     Boolean       @default(true)
  acceptedMarketing Boolean       @default(false) // Consentimiento separado para promociones
  ipAddress         String
  userAgent         String
  consentedAt       DateTime      @default(now())

  @@index([userId, consentedAt])
}

// -------------------------------------------------------------
// AUDITORÍA DE CORREOS TRANSACCIONALES
// -------------------------------------------------------------

model EmailAuditLog {
  id              String        @id @default(uuid())
  appointmentId   String
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipientType   String        // CLIENT, BARBER, ADMIN
  toEmail         String
  subject         String
  providerId      String?       // ID devuelto por Resend
  status          String        @default("QUEUED") // QUEUED, SENT, DELIVERED, BOUNCED, FAILED
  attempts        Int           @default(1)
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([appointmentId, status])
}

// -------------------------------------------------------------
// SESIONES Y AUDITORÍA DE SEGURIDAD
// -------------------------------------------------------------

model StaffDeviceSession {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String        // UUID único generado por la app móvil o navegador
  deviceName      String?       // Ej: "iPhone 15 Pro de Brayan", "Terminal Recepción"
  refreshTokenHash String
  biometricsEnabled Boolean     @default(false)
  isRevoked       Boolean       @default(false)
  lastActiveAt    DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@unique([userId, deviceId])
}

model AuditLog {
  id              String        @id @default(uuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  action          String        // LOGIN, PRECIO_MODIFICADO, CITA_REASIGNADA, CIERRE_CAJA
  resource        String        // "Appointment", "Service", "CashSession"
  resourceId      String?
  details         String?       // JSON serializado con cambios
  ipAddress       String?
  createdAt       DateTime      @default(now())

  @@index([action, createdAt])
}

